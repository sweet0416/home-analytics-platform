# Phase 3 deployment manifest template only. NOT_DEPLOYED.
# Fill from the successful GitHub Actions/GHCR record before a real deployment.

PROJECT=HAP
DEPLOYMENT_REVISION=sha-<FULL_GIT_SHA>
HAP_IMAGE_REVISION=<FULL_GIT_SHA>

HAP_BACKEND_IMAGE=ghcr.io/sweet0416/home-analytics-platform-backend@sha256:<BACKEND_DIGEST>
HAP_BACKEND_DIGEST=sha256:<BACKEND_DIGEST>
HAP_BACKEND_BUILD_TIME=<BACKEND_CI_BUILD_TIME_UTC>

HAP_FRONTEND_IMAGE=ghcr.io/sweet0416/home-analytics-platform-frontend@sha256:<FRONTEND_DIGEST>
HAP_FRONTEND_DIGEST=sha256:<FRONTEND_DIGEST>

HAP_TTSKILL_AGENT_IMAGE=ghcr.io/sweet0416/home-analytics-platform-ttskill-agent@sha256:<TTSKILL_AGENT_DIGEST>
HAP_TTSKILL_AGENT_DIGEST=sha256:<TTSKILL_AGENT_DIGEST>

GITHUB_ACTIONS_RUN_ID=<SUCCESSFUL_RUN_ID>
COMPOSE_REVISION=<COMPOSE_GIT_SHA_OR_RELEASE>
DEPLOYMENT_TIME=NOT_DEPLOYED
